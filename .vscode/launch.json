{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "imToken Fans: 启动并预览 (3000)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/node_modules/next/dist/bin/next",
      "runtimeExecutable": "${workspaceFolder}/node_modules/node/bin/node",
      "args": [
        "dev",
        "--port",
        "3000",
        "--hostname",
        "127.0.0.1"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ],
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://[^\\s]+)",
        "uriFormat": "http://localhost:3000",
        "action": "openExternally"
      }
    },
    {
      "name": "imToken Fans: 调试已运行页面 (3000)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000"
    }
  ]
}
